# Secrets — never commit keys. Copy .env.example to .env locally.
.env
.env.*
!.env.example

# Python
venv/
env/
.venv/
ENV/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Vector index (rebuilt by scripts/ingest.py)
.chroma/
*.sqlite3

# Live traces (regenerate with scripts/collect_traces.py)
traces/*.jsonl

# Generated eval dumps (results.md is the report we keep)
results/*.json

# OS / editor
.DS_Store
**/.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Local talk notes (not product / assignment artifacts)
TALK.md
WEEK7-TALK.md

# Runtime logs from Week 7 budget-termination runs
eval/week7/*.log

# Cursor
.cursor/
